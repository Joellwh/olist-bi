# Finales de línea deterministas: el mismo commit produce los mismos bytes en
# Windows y en el CI de Linux.
*.py    text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.ipynb text eol=lf

# Definición del modelo y del reporte de Power BI (PBIP / TMDL): texto, para
# que los cambios se vean línea por línea en los diffs.
*.tmdl  text eol=lf
*.pbir  text eol=lf
*.pbism text eol=lf
*.pbip  text eol=lf

# Binarios
*.png   binary
*.pbix  binary
*.abf   binary

# Estadísticas de lenguaje de GitHub (la barra "Languages" del repo).
# El SQL, el modelo semántico (TMDL) y las consultas DAX son el centro del
# proyecto: que cuenten. GitHub trata TMDL como "datos" y no lo muestra si no
# se le pide.
*.sql  linguist-detectable=true
*.tmdl linguist-detectable=true
*.dax  linguist-language=DAX linguist-detectable=true
# El notebook es el informe del perfilado: el 90% de sus bytes son salidas
# guardadas (tablas e imágenes), no código. Cuenta como documentación.
*.ipynb linguist-documentation
