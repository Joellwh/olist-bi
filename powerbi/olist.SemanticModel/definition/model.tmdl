model Model
	culture: es-AR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: es-AR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Servidor","BaseDatos","dim_fecha","dim_geografia","dim_cliente","dim_vendedor","dim_producto","fact_items","fact_pedidos","Gerentes"]

annotation PBI_ProTooling = ["DevMode","DaxQueryView_Desktop"]

ref table _Medidas
ref table dim_fecha
ref table dim_geografia
ref table dim_cliente
ref table dim_vendedor
ref table dim_producto
ref table fact_items
ref table fact_pedidos
ref table 'Top N'
ref table 'Meses desde cohorte'
ref table 'Selector de métrica'
ref table 'Eje del flete'
ref table Gerentes

ref role Dirección
ref role 'Gerente regional'
ref role 'Región Centro-Oeste'
ref role 'Región Nordeste'
ref role 'Región Norte'
ref role 'Región Sudeste'
ref role 'Región Sur'

ref cultureInfo es-AR

