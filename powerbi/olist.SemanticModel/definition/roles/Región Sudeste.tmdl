/// RLS estático: solo los estados de la región Sudeste. Un rol por región, para comparar con el dinámico.
role 'Región Sudeste'
	modelPermission: read

	tablePermission dim_geografia = [Región] = "Sudeste"

	tablePermission Gerentes = FALSE ()

