/// RLS estático: solo los estados de la región Centro-Oeste. Un rol por región, para comparar con el dinámico.
role 'Región Centro-Oeste'
	modelPermission: read

	tablePermission dim_geografia = [Región] = "Centro-Oeste"

	tablePermission Gerentes = FALSE ()

