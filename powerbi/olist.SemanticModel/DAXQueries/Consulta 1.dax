EVALUATE
    TOPN(100, '_Medidas')
EVALUATE
CALCULATETABLE(
    ROW(
        "K20 Con demora", CALCULATE(COUNTROWS(fact_pedidos), fact_pedidos[es_entregado] = TRUE(), fact_pedidos[a_tiempo] = FALSE())
    ),
    dim_fecha[En período de análisis] = TRUE()
)