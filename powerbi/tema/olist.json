{
  "name": "Olist BI",
  "dataColors": ["#2563EB", "#8B93A0", "#1E3A8A", "#60A5FA", "#DC2626", "#374151", "#93C5FD", "#4B5563"],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#2563EB",
  "good": "#2563EB",
  "neutral": "#8B93A0",
  "bad": "#DC2626",
  "maximum": "#1E3A8A",
  "center": "#60A5FA",
  "minimum": "#DBEAFE",
  "textClasses": {
    "callout": { "fontSize": 27, "fontFace": "Segoe UI Semibold", "color": "#1F2937" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F2937" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F2937" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#4B5563" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1F2937" } }, "fontSize": 12, "alignment": "left" }],
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#D1D5DB" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }]
      }
    },
    "cardVisual": {
      "*": {
        "padding": [{ "$id": "default", "paddingIndividual": true, "topMargin": 8, "rightMargin": 16, "bottomMargin": 8, "leftMargin": 16 }],
        "outline": [{ "$id": "default", "show": false }]
      }
    },
    "lineChart": { "*": { "lineStyles": [{ "lineChartType": "linear" }] } },
    "lineClusteredColumnComboChart": { "*": { "lineStyles": [{ "lineChartType": "linear" }] } },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F3F4F6" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F3F4F6" } } }]
      }
    }
  }
}
